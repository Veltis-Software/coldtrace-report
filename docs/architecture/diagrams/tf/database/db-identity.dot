digraph G {
graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Arial", bgcolor="white", pad=0.15, newrank=true];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [color="#1F4E79", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.1];
"organizations" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>organizations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">commercial_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">contact_email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">legal_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">tax_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">first_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">last_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">uuid</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR></TABLE>>];
"roles" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">label</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR></TABLE>>];
"role_permissions" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>role_permissions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>FK </B></FONT>role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">action</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">resource</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR></TABLE>>];
"external_identities" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>external_identities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">provider</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(32) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">provider_subject</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR></TABLE>>];
"password_reset_requests" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>password_reset_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">consumed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">expires_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">requested_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">token_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(128) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR></TABLE>>];
"subscription_initialization_outbox" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#A6A6A6"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>subscription_initialization_outbox</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777" POINT-SIZE="8"><I>tabla técnica: 3 columnas</I></FONT></TD></TR></TABLE>>];
{rank=same; "organizations"; "users"; "roles";}
{rank=same; "role_permissions"; "external_identities"; "password_reset_requests";}
{rank=same; "subscription_initialization_outbox";}
"organizations" -> "role_permissions" [style=invis];
"role_permissions" -> "subscription_initialization_outbox" [style=invis];
"organizations" -> "users" [style=invis];
"users" -> "roles" [style=invis];
"role_permissions" -> "external_identities" [style=invis];
"external_identities" -> "password_reset_requests" [style=invis];
"roles" -> "role_permissions" [constraint=false];
"organizations" -> "users" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"roles" -> "users" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"users" -> "external_identities" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"users" -> "password_reset_requests" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"organizations" -> "subscription_initialization_outbox" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
labelloc="t"; label=<<B>ct_identity</B> (MySQL 8.4) - Identity Service>; fontsize=13;}