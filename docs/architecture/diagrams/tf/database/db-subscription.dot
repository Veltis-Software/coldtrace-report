digraph G {
graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Arial", bgcolor="white", pad=0.15, newrank=true];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [color="#1F4E79", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.1];
"subscription_plans" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>subscription_plans</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">active</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">allows_ai_guidance</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">allows_ai_report_summary</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">allows_exports</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">allows_maintenance</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">code</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(40) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">currency</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(3) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">history_retention_days</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">max_assets</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">max_iot_devices</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">max_locations</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">max_users</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">monthly_price_cents</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">recommended</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">recommended_label</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">stripe_price_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR></TABLE>>];
"subscription_plan_included_features" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>subscription_plan_included_features</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>FK </B></FONT>subscription_plan_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">feature</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR></TABLE>>];
"organization_subscriptions" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>organization_subscriptions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">cancel_at_period_end</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">current_period_end</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">current_period_start</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">metadata</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(2000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">plan_code</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(40) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">provider</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">provider_customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">provider_subscription_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum NN</FONT></TD></TR></TABLE>>];
"billing_webhook_events" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#A6A6A6"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>billing_webhook_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777" POINT-SIZE="8"><I>tabla técnica: 12 columnas</I></FONT></TD></TR></TABLE>>];
{rank=same; "subscription_plans"; "subscription_plan_included_features"; "organization_subscriptions"; "billing_webhook_events";}
"subscription_plans" -> "subscription_plan_included_features" [style=invis];
"subscription_plan_included_features" -> "organization_subscriptions" [style=invis];
"organization_subscriptions" -> "billing_webhook_events" [style=invis];
"subscription_plans" -> "subscription_plan_included_features" [constraint=false];
labelloc="t"; label=<<B>ct_subscription</B> (MySQL 8.4) - Subscription Service>; fontsize=13;}