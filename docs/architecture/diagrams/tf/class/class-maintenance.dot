digraph G {
graph [rankdir=TB, splines=true, newrank=true, nodesep=0.35, ranksep=0.5, fontname="Arial", pad=0.15];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [arrowhead=vee, color="#1F4E79", fontname="Arial", fontsize=8];
"MaintenanceSchedule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>MaintenanceSchedule</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- uuid: String</TD></TR><TR><TD ALIGN="LEFT">- assetId: Long</TD></TR><TR><TD ALIGN="LEFT">- scheduledDate: OffsetDateTime</TD></TR><TR><TD ALIGN="LEFT">- frequencyDays: Integer</TD></TR><TR><TD ALIGN="LEFT">- responsibleUserId: Long</TD></TR><TR><TD ALIGN="LEFT">- observations: String</TD></TR><TR><TD ALIGN="LEFT">- status: String</TD></TR><TR><TD ALIGN="LEFT">- registeredAt: OffsetDateTime</TD></TR><HR/><TR><TD ALIGN="LEFT">+ canTransitionTo()</TD></TR><TR><TD ALIGN="LEFT">+ onCreated()</TD></TR><TR><TD ALIGN="LEFT">+ updateStatus()</TD></TR></TABLE>>];
"TechnicalServiceRequest" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>TechnicalServiceRequest</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- code: String</TD></TR><TR><TD ALIGN="LEFT">- assetId: Long</TD></TR><TR><TD ALIGN="LEFT">- assetLocationId: Long</TD></TR><TR><TD ALIGN="LEFT">- assetName: String</TD></TR><TR><TD ALIGN="LEFT">- incidentId: Long</TD></TR><TR><TD ALIGN="LEFT">- issueDescription: String</TD></TR><TR><TD ALIGN="LEFT">- priority: String</TD></TR><TR><TD ALIGN="LEFT">- status: String</TD></TR><TR><TD ALIGN="LEFT">- requestedBy: String</TD></TR><TR><TD ALIGN="LEFT">- requestedAt: OffsetDateTime</TD></TR><TR><TD ALIGN="LEFT">- closedAt: OffsetDateTime</TD></TR><TR><TD ALIGN="LEFT">- closureSummary: String</TD></TR><TR><TD ALIGN="LEFT"><I>… 2 atributos más</I></TD></TR><HR/><TR><TD ALIGN="LEFT">+ canTransitionTo()</TD></TR><TR><TD ALIGN="LEFT">+ onCreated()</TD></TR><TR><TD ALIGN="LEFT">+ updateStatus()</TD></TR></TABLE>>];
{rank=same; "TechnicalServiceRequest"; "MaintenanceSchedule";}
"TechnicalServiceRequest" -> "MaintenanceSchedule" [style=invis];
labelloc="t"; label=<<B>Maintenance Service</B> - modelo de dominio>; fontsize=13;}