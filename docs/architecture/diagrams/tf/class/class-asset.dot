digraph G {
graph [rankdir=TB, splines=true, newrank=true, nodesep=0.35, ranksep=0.5, fontname="Arial", pad=0.15];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [arrowhead=vee, color="#1F4E79", fontname="Arial", fontsize=8];
"Asset" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>Asset</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- locationId: Long</TD></TR><TR><TD ALIGN="LEFT">- uuid: AssetUuid</TD></TR><TR><TD ALIGN="LEFT">- type: String</TD></TR><TR><TD ALIGN="LEFT">- name: String</TD></TR><TR><TD ALIGN="LEFT">- capacity: Double</TD></TR><TR><TD ALIGN="LEFT">- description: String</TD></TR><TR><TD ALIGN="LEFT">- status: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ onCreated()</TD></TR><TR><TD ALIGN="LEFT">+ update()</TD></TR></TABLE>>];
"AssetSettings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>AssetSettings</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- assetId: Long</TD></TR><TR><TD ALIGN="LEFT">- uuid: String</TD></TR><TR><TD ALIGN="LEFT">- assetTypes: List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT">- iotDeviceTypes: List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT">- minimumTemperature: Double</TD></TR><TR><TD ALIGN="LEFT">- maximumTemperature: Double</TD></TR><TR><TD ALIGN="LEFT">- minimumHumidity: Double</TD></TR><TR><TD ALIGN="LEFT">- maximumHumidity: Double</TD></TR><TR><TD ALIGN="LEFT">- calibrationFrequencyDays: Integer</TD></TR><TR><TD ALIGN="LEFT">- temperatureUnit: String</TD></TR><TR><TD ALIGN="LEFT">- humidityUnit: String</TD></TR><TR><TD ALIGN="LEFT">- weightUnit: String</TD></TR><TR><TD ALIGN="LEFT"><I>… 2 atributos más</I></TD></TR><HR/><TR><TD ALIGN="LEFT">+ update()</TD></TR></TABLE>>];
"AssetUuid" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>AssetUuid</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ value: String</TD></TR></TABLE>>];
"Gateway" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>Gateway</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- locationId: Long</TD></TR><TR><TD ALIGN="LEFT">- uuid: GatewayUuid</TD></TR><TR><TD ALIGN="LEFT">- name: String</TD></TR><TR><TD ALIGN="LEFT">- network: String</TD></TR><TR><TD ALIGN="LEFT">- status: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ update()</TD></TR></TABLE>>];
"GatewayUuid" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>GatewayUuid</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ value: String</TD></TR></TABLE>>];
"IoTDevice" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>IoTDevice</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- gatewayId: Long</TD></TR><TR><TD ALIGN="LEFT">- uuid: IoTDeviceUuid</TD></TR><TR><TD ALIGN="LEFT">- deviceType: String</TD></TR><TR><TD ALIGN="LEFT">- model: String</TD></TR><TR><TD ALIGN="LEFT">- measurementType: String</TD></TR><TR><TD ALIGN="LEFT">- measurementParameters: List&lt;String&gt;</TD></TR><TR><TD ALIGN="LEFT">- readingFrequencySeconds: Integer</TD></TR><TR><TD ALIGN="LEFT">- assetId: Long</TD></TR><TR><TD ALIGN="LEFT">- status: String</TD></TR><TR><TD ALIGN="LEFT">- calibrationStatus: String</TD></TR><TR><TD ALIGN="LEFT">- lastCalibrationDate: LocalDate</TD></TR><TR><TD ALIGN="LEFT">- nextCalibrationDate: LocalDate</TD></TR><HR/><TR><TD ALIGN="LEFT">+ associateSourceAsset()</TD></TR><TR><TD ALIGN="LEFT">+ update()</TD></TR></TABLE>>];
"IoTDeviceUuid" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>IoTDeviceUuid</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ value: String</TD></TR></TABLE>>];
"Location" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>Location</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- name: LocationName</TD></TR><TR><TD ALIGN="LEFT">- type: String</TD></TR><TR><TD ALIGN="LEFT">- address: String</TD></TR><TR><TD ALIGN="LEFT">- description: String</TD></TR><TR><TD ALIGN="LEFT">- status: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ update()</TD></TR></TABLE>>];
"LocationName" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>LocationName</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ value: String</TD></TR></TABLE>>];
"SourceConfiguration" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>SourceConfiguration</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ organizationId: long</TD></TR><TR><TD ALIGN="LEFT">+ deviceId: long</TD></TR><TR><TD ALIGN="LEFT">+ deviceUuid: String</TD></TR><TR><TD ALIGN="LEFT">+ gatewayId: long</TD></TR><TR><TD ALIGN="LEFT">+ assetId: long</TD></TR><TR><TD ALIGN="LEFT">+ configurationVersion: long</TD></TR><TR><TD ALIGN="LEFT">+ profile: SourceProfile</TD></TR><TR><TD ALIGN="LEFT">+ changedBy: long</TD></TR><TR><TD ALIGN="LEFT">+ changedAt: String</TD></TR><TR><TD ALIGN="LEFT">+ reason: String</TD></TR></TABLE>>];
"SourceProfile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>SourceProfile</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ sourceId: String</TD></TR><TR><TD ALIGN="LEFT">+ transport: String</TD></TR><TR><TD ALIGN="LEFT">+ profileVersion: int</TD></TR><TR><TD ALIGN="LEFT">+ schemaVersion: int</TD></TR><TR><TD ALIGN="LEFT">+ fields: Map&lt;String, String&gt;</TD></TR><TR><TD ALIGN="LEFT">+ temperatureUnit: String</TD></TR><TR><TD ALIGN="LEFT">+ humidityUnit: String</TD></TR></TABLE>>];
{rank=same; "AssetSettings"; "IoTDevice"; "Asset"; "Gateway";}
{rank=same; "Location"; "SourceConfiguration"; "SourceProfile"; "AssetUuid";}
{rank=same; "GatewayUuid"; "IoTDeviceUuid"; "LocationName";}
"AssetSettings" -> "Location" [style=invis];
"Location" -> "GatewayUuid" [style=invis];
"AssetSettings" -> "IoTDevice" [style=invis];
"IoTDevice" -> "Asset" [style=invis];
"Asset" -> "Gateway" [style=invis];
"Location" -> "SourceConfiguration" [style=invis];
"SourceConfiguration" -> "SourceProfile" [style=invis];
"SourceProfile" -> "AssetUuid" [style=invis];
"GatewayUuid" -> "IoTDeviceUuid" [style=invis];
"IoTDeviceUuid" -> "LocationName" [style=invis];
"Asset" -> "AssetUuid" [arrowtail=diamond, dir=both, arrowhead=vee, constraint=false];
"Gateway" -> "GatewayUuid" [arrowtail=diamond, dir=both, arrowhead=vee, constraint=false];
"IoTDevice" -> "IoTDeviceUuid" [arrowtail=diamond, dir=both, arrowhead=vee, constraint=false];
"Location" -> "LocationName" [arrowtail=diamond, dir=both, arrowhead=vee, constraint=false];
"SourceConfiguration" -> "SourceProfile" [style=dashed, constraint=false];
labelloc="t"; label=<<B>Asset Service</B> - modelo de dominio>; fontsize=13;}