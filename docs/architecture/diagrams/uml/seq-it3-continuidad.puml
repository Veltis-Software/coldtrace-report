@startuml seq-it3-continuidad
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam ParticipantBackgroundColor #438dd5
skinparam ParticipantFontColor white
skinparam ParticipantBorderColor #2e6295
skinparam ActorBackgroundColor #08427b
skinparam ActorBorderColor #08427b
skinparam DatabaseBackgroundColor #438dd5
skinparam DatabaseFontColor black
skinparam QueueBackgroundColor #438dd5
skinparam QueueFontColor black
skinparam SequenceLifeLineBorderColor #888888
skinparam NoteBackgroundColor #fff8c4
skinparam NoteBorderColor #c9b200
skinparam ArrowColor #333333

title Iteración 3 - Continuidad de evaluación y publicación asíncrona
participant "Edge (vía\nAPI Gateway)" as E #2e7d32
participant "Monitoring\nService" as M
database "Esquema\nmonitoring" as DB
participant "Outbox Relay" as R
queue "Pub/Sub" as P
participant "Alert / Reports" as C
E -> M : lote canónico validado
M -> M : evaluar con réplica\nlocal de rangos
M -> DB : BEGIN\nINSERT lectura\nUPDATE estado actual\nINSERT evento Outbox\nCOMMIT
M --> E : 202 accepted / duplicated
R -> DB : consultar eventos\npendientes
R -> P : publicar eventos
P -> C : entregar eventos
C -> C : deduplicar y actualizar\nproyecciones
note over R,C : Conserva la ruta asíncrona de la Iteración 2
@enduml
