digraph G {
graph [rankdir=TB, splines=true, newrank=true, nodesep=0.35, ranksep=0.5, fontname="Arial", pad=0.15];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [arrowhead=vee, color="#1F4E79", fontname="Arial", fontsize=8];
"BillingProvider" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>«enumeration»<BR/>BillingProvider</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">NONE</TD></TR><TR><TD ALIGN="LEFT">STRIPE</TD></TR></TABLE>>];
"BillingWebhookEvent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>BillingWebhookEvent</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- provider: BillingProvider</TD></TR><TR><TD ALIGN="LEFT">- eventId: String</TD></TR><TR><TD ALIGN="LEFT">- eventType: String</TD></TR><TR><TD ALIGN="LEFT">- status: BillingWebhookEventStatus</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- providerCustomerId: String</TD></TR><TR><TD ALIGN="LEFT">- providerSubscriptionId: String</TD></TR><TR><TD ALIGN="LEFT">- processedAt: OffsetDateTime</TD></TR><TR><TD ALIGN="LEFT">- metadata: String</TD></TR></TABLE>>];
"BillingWebhookEventStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>«enumeration»<BR/>BillingWebhookEventStatus</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">PROCESSED</TD></TR><TR><TD ALIGN="LEFT">IGNORED</TD></TR></TABLE>>];
"OrganizationSubscription" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>OrganizationSubscription</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- organizationId: Long</TD></TR><TR><TD ALIGN="LEFT">- planCode: String</TD></TR><TR><TD ALIGN="LEFT">- status: SubscriptionStatus</TD></TR><TR><TD ALIGN="LEFT">- provider: BillingProvider</TD></TR><TR><TD ALIGN="LEFT">- providerCustomerId: String</TD></TR><TR><TD ALIGN="LEFT">- providerSubscriptionId: String</TD></TR><TR><TD ALIGN="LEFT">- currentPeriodStart: OffsetDateTime</TD></TR><TR><TD ALIGN="LEFT">- currentPeriodEnd: OffsetDateTime</TD></TR><TR><TD ALIGN="LEFT">- cancelAtPeriodEnd: Boolean</TD></TR><TR><TD ALIGN="LEFT">- metadata: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ allowsPlanEntitlements()</TD></TR><TR><TD ALIGN="LEFT">+ synchronizeProviderState()</TD></TR></TABLE>>];
"PlanFeatureFlags" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>PlanFeatureFlags</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ allowsExports: boolean</TD></TR><TR><TD ALIGN="LEFT">+ allowsMaintenance: boolean</TD></TR><TR><TD ALIGN="LEFT">+ allowsAiGuidance: boolean</TD></TR><TR><TD ALIGN="LEFT">+ allowsAiReportSummary: boolean</TD></TR></TABLE>>];
"PlanUsageLimits" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#2E75B6"><FONT COLOR="white"><B>«record»<BR/>PlanUsageLimits</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+ maxLocations: Integer</TD></TR><TR><TD ALIGN="LEFT">+ maxAssets: Integer</TD></TR><TR><TD ALIGN="LEFT">+ maxIotDevices: Integer</TD></TR><TR><TD ALIGN="LEFT">+ maxUsers: Integer</TD></TR><TR><TD ALIGN="LEFT">+ historyRetentionDays: Integer</TD></TR></TABLE>>];
"SubscriptionPlan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#1F4E79"><FONT COLOR="white"><B>SubscriptionPlan</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: Long</TD></TR><TR><TD ALIGN="LEFT">- code: String</TD></TR><TR><TD ALIGN="LEFT">- displayName: String</TD></TR><TR><TD ALIGN="LEFT">- description: String</TD></TR><TR><TD ALIGN="LEFT">- currency: String</TD></TR><TR><TD ALIGN="LEFT">- monthlyPriceCents: Integer</TD></TR><TR><TD ALIGN="LEFT">- stripePriceId: String</TD></TR><TR><TD ALIGN="LEFT">- recommended: Boolean</TD></TR><TR><TD ALIGN="LEFT">- recommendedLabel: String</TD></TR><TR><TD ALIGN="LEFT">- active: Boolean</TD></TR><TR><TD ALIGN="LEFT">- usageLimits: PlanUsageLimits</TD></TR><TR><TD ALIGN="LEFT">- featureFlags: PlanFeatureFlags</TD></TR><TR><TD ALIGN="LEFT">- includedFeatures: List&lt;String&gt;</TD></TR></TABLE>>];
"SubscriptionStatus" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>«enumeration»<BR/>SubscriptionStatus</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">FREE</TD></TR><TR><TD ALIGN="LEFT">ACTIVE</TD></TR><TR><TD ALIGN="LEFT">PAST_DUE</TD></TR><TR><TD ALIGN="LEFT">CANCELED</TD></TR></TABLE>>];
{rank=same; "SubscriptionPlan"; "OrganizationSubscription"; "BillingWebhookEvent";}
{rank=same; "PlanUsageLimits"; "PlanFeatureFlags"; "SubscriptionStatus";}
{rank=same; "BillingProvider"; "BillingWebhookEventStatus";}
"SubscriptionPlan" -> "PlanUsageLimits" [style=invis];
"PlanUsageLimits" -> "BillingProvider" [style=invis];
"SubscriptionPlan" -> "OrganizationSubscription" [style=invis];
"OrganizationSubscription" -> "BillingWebhookEvent" [style=invis];
"PlanUsageLimits" -> "PlanFeatureFlags" [style=invis];
"PlanFeatureFlags" -> "SubscriptionStatus" [style=invis];
"BillingProvider" -> "BillingWebhookEventStatus" [style=invis];
"OrganizationSubscription" -> "SubscriptionStatus" [style=dashed, constraint=false];
"OrganizationSubscription" -> "BillingProvider" [style=dashed, constraint=false];
"SubscriptionPlan" -> "PlanUsageLimits" [arrowtail=diamond, dir=both, arrowhead=vee, constraint=false];
"SubscriptionPlan" -> "PlanFeatureFlags" [arrowtail=diamond, dir=both, arrowhead=vee, constraint=false];
"BillingWebhookEvent" -> "BillingProvider" [style=dashed, constraint=false];
"BillingWebhookEvent" -> "BillingWebhookEventStatus" [style=dashed, constraint=false];
labelloc="t"; label=<<B>Subscription Service</B> - modelo de dominio>; fontsize=13;}