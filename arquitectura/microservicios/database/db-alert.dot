digraph G {
graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Arial", bgcolor="white", pad=0.15, newrank=true];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [color="#1F4E79", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.1];
"processed_events" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#A6A6A6"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>processed_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777" POINT-SIZE="8"><I>tabla técnica: 2 columnas</I></FONT></TD></TR></TABLE>>];
"incidents" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>incidents</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">device_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">reading_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">source_event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(40) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">severity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">detected_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">resolved_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">assigned_to_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">assignee_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">acknowledged_by_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">acknowledged_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">context_payload</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">json</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">assigned_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">resolved_by_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR></TABLE>>];
"notifications" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">incident_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">channel</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">deep_link</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR></TABLE>>];
"outbox_events" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#A6A6A6"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>outbox_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">aggregate_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777" POINT-SIZE="8"><I>tabla técnica: 10 columnas</I></FONT></TD></TR></TABLE>>];
"alert_updates" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>alert_updates</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>sequence_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">incident_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">payload</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">json NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">occurred_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR></TABLE>>];
"corrective_actions" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>corrective_actions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">incident_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">author_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(2000) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR></TABLE>>];
"incident_ai_resolution_plans" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>incident_ai_resolution_plans</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">approved_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">approved_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">corrective_action_draft</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">escalation_reason</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(800) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">escalation_recommended</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bit NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">escalation_urgency</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(120) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">final_corrective_action</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">final_resolution_notes</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">generated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">incident_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">model_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(160) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">model_provider</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(80) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">probable_cause</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(800) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">provider_metadata</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">rejected_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">rejected_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">rejection_reason</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">resolution_notes_draft</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">summary</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(500) NN</FONT></TD></TR></TABLE>>];
"incident_ai_resolution_plan_required_evidences" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>incident_ai_resolution_plan_required_evidences</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK FK </B></FONT>ai_resolution_plan_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">required_evidence</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(400) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR></TABLE>>];
"incident_ai_resolution_plan_steps" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>incident_ai_resolution_plan_steps</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK FK </B></FONT>ai_resolution_plan_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">action</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(400) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">expected_outcome</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(400) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">rationale</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(500) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">step_sequence</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR></TABLE>>];
"incident_ai_resolution_plan_uncertainty_notes" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>incident_ai_resolution_plan_uncertainty_notes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK FK </B></FONT>ai_resolution_plan_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">uncertainty_note</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(500) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>position</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR></TABLE>>];
{rank=same; "processed_events"; "incidents"; "notifications"; "outbox_events";}
{rank=same; "alert_updates"; "corrective_actions"; "incident_ai_resolution_plans"; "incident_ai_resolution_plan_required_evidences";}
{rank=same; "incident_ai_resolution_plan_steps"; "incident_ai_resolution_plan_uncertainty_notes";}
"processed_events" -> "alert_updates" [style=invis];
"alert_updates" -> "incident_ai_resolution_plan_steps" [style=invis];
"processed_events" -> "incidents" [style=invis];
"incidents" -> "notifications" [style=invis];
"notifications" -> "outbox_events" [style=invis];
"alert_updates" -> "corrective_actions" [style=invis];
"corrective_actions" -> "incident_ai_resolution_plans" [style=invis];
"incident_ai_resolution_plans" -> "incident_ai_resolution_plan_required_evidences" [style=invis];
"incident_ai_resolution_plan_steps" -> "incident_ai_resolution_plan_uncertainty_notes" [style=invis];
"incident_ai_resolution_plans" -> "incident_ai_resolution_plan_required_evidences" [constraint=false];
"incident_ai_resolution_plans" -> "incident_ai_resolution_plan_steps" [constraint=false];
"incident_ai_resolution_plans" -> "incident_ai_resolution_plan_uncertainty_notes" [constraint=false];
"incidents" -> "notifications" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"incidents" -> "alert_updates" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"incidents" -> "corrective_actions" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"incidents" -> "incident_ai_resolution_plans" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
labelloc="t"; label=<<B>ct_alert</B> (MySQL 8.4) - Alert Service>; fontsize=13;}