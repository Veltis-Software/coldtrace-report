digraph G {
graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Arial", bgcolor="white", pad=0.15, newrank=true];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [color="#1F4E79", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.1];
"reading_aggregates" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>reading_aggregates</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">hour_start</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">reading_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">out_of_range_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">min_temperature</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">double</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">max_temperature</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">double</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">sum_temperature</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">double</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">min_humidity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">double</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">max_humidity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">double</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">sum_humidity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">double</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">temperature_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">humidity_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR></TABLE>>];
"processed_events" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#A6A6A6"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>processed_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>consumer</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">char</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777" POINT-SIZE="8"><I>tabla técnica: 3 columnas</I></FONT></TD></TR></TABLE>>];
"reading_samples" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>reading_samples</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>reading_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">recorded_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">payload</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">json NN</FONT></TD></TR></TABLE>>];
"incident_projection" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>incident_projection</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>incident_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">detected_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">payload</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">json NN</FONT></TD></TR></TABLE>>];
"reports" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>reports</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">requested_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">title</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(200) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">period_start</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">period_end</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">incident_snapshot</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">json NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">result</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">json</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">completed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">report_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(32)</FONT></TD></TR></TABLE>>];
{rank=same; "reading_aggregates"; "processed_events"; "reading_samples";}
{rank=same; "incident_projection"; "reports";}
"reading_aggregates" -> "incident_projection" [style=invis];
"reading_aggregates" -> "processed_events" [style=invis];
"processed_events" -> "reading_samples" [style=invis];
"incident_projection" -> "reports" [style=invis];
labelloc="t"; label=<<B>ct_report</B> (MySQL 8.4) - Report Service>; fontsize=13;}