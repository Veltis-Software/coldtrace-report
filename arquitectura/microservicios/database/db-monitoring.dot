NT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">sequence_number</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">source_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">profile_version</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">schema_version</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">temperature_unit</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">humidity_unit</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(8)</FONT></TD></TR></TABLE>>];
