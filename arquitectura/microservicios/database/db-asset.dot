LOR="white">uuid</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">weight_unit</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR></TABLE>>];
"asset_settings_asset_types" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>asset_settings_asset_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>FK </B></FONT>asset_settings_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR></TABLE>>];
