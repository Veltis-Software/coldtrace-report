{rank=same; "locations"; "gateways"; "assets"; "iot_devices";}
{rank=same; "iot_device_measurement_parameters"; "asset_settings"; "asset_settings_asset_types"; "asset_settings_iot_device_types";}
{rank=same; "asset_settings_versions"; "asset_integration_outboxes"; "source_configurations"; "source_configuration_histories";}
