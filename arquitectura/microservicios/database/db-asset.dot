"gateways" -> "iot_devices" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"assets" -> "asset_settings" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"assets" -> "asset_settings_versions" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"iot_devices" -> "source_configurations" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"gateways" -> "source_configurations" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
"iot_devices" -> "source_configuration_histories" [constraint=false, style=dashed, color="#8FA9C8", arrowhead=crow, arrowtail=none];
