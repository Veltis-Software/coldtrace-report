"asset_settings_versions" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>asset_settings_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">settings_version</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR></TABLE>>];
"asset_integration_outboxes" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#A6A6A6"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F"><FONT COLOR="white"><B>asset_integration_outboxes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">event_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(36)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">published_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#777777" POINT-SIZE="8"><I>tabla técnica: 5 columnas</I></FONT></TD></TR></TABLE>>];
"source_configurations" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>source_configurations</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>device_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">configuration_version</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">gateway_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">snapshot</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">text NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">source_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(64) NN</FONT></TD></TR></TABLE>>];
