digraph G {
graph [rankdir=TB, splines=true, nodesep=0.35, ranksep=0.45, fontname="Arial", bgcolor="white", pad=0.15, newrank=true];
node [shape=plaintext, fontname="Arial", fontsize=10];
edge [color="#1F4E79", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.1];
"maintenance_schedules" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>maintenance_schedules</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">frequency_days</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">observations</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">registered_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">responsible_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">scheduled_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">uuid</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR></TABLE>>];
"technical_service_requests" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F"><TR><TD COLSPAN="2" BGCOLOR="#1F4E79"><FONT COLOR="white"><B>technical_service_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="8" COLOR="#1F4E79"><B>PK </B></FONT>id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_location_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">asset_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">closed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">closed_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">closure_summary</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">code</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">evidence</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">incident_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">issue_description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(1000) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">organization_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bigint NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">priority</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">requested_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime NN</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">requested_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255) NN</FONT></TD></TR></TABLE>>];
{rank=same; "maintenance_schedules"; "technical_service_requests";}
"maintenance_schedules" -> "technical_service_requests" [style=invis];
labelloc="t"; label=<<B>ct_maintenance</B> (MySQL 8.4) - Maintenance Service>; fontsize=13;}